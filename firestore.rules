rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'qEaFZDzP02O7kyUVpHNfM7FiZmz1' ||
        request.auth.token.email == 'rmartbdltd@gmail.com' ||
        request.auth.token.email == 'ahmedskkawsar43@gmail.com' ||
        request.auth.token.email == 'rayhanahamad50@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'))
      );
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId;
      allow update: if isValidId(userId) && isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Orders Collection (Guest checkout allowed)
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isValidId(orderId) &&
        request.resource.data.orderNumber is string &&
        request.resource.data.customerPhone is string &&
        request.resource.data.total is number;
      allow update, delete: if isAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow get, list: if resource.data.isApproved == true || isAdmin();
      allow create: if isValidId(reviewId) &&
        request.resource.data.rating is number &&
        request.resource.data.customerName is string;
      allow update, delete: if isAdmin();
    }

    // Catering Collection
    match /catering/{inquiryId} {
      allow create: if isValidId(inquiryId) &&
        request.resource.data.customerName is string &&
        request.resource.data.customerPhone is string;
      allow get, list, update, delete: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'qEaFZDzP02O7kyUVpHNfM7FiZmz1' ||
        request.auth.token.email == 'rmartbdltd@gmail.com' ||
        request.auth.token.email == 'ahmedskkawsar43@gmail.com' ||
        request.auth.token.email == 'rayhanahamad50@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'))
      );
    }

    // Foods (Products) Collection - Public Read, Admin Write
    match /foods/{foodId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Allow server-side sync & admin updates
    }

    // Categories Collection - Public Read, Admin Write
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Business Config & Banners Collection
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Delivery Zones Collection
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Payment Methods Collection
    match /paymentMethods/{pmId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // System Store (Full Database Cloud Snapshot & Sync)
    match /system_store/{storeDoc} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isSignedIn() && (request.auth.uid == userId || isAdmin()));
      allow list: if isAdmin();
      allow create: if isValidId(userId);
      allow update: if isValidId(userId);
      allow delete: if isAdmin();
    }

    // Orders Collection (Guest checkout allowed)
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isValidId(orderId);
      allow update, delete: if isAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isValidId(reviewId);
      allow update, delete: if isAdmin();
    }

    // Catering Collection
    match /catering/{inquiryId} {
      allow create: if isValidId(inquiryId);
      allow get, list, update, delete: if isAdmin();
    }
  }
}
